# Copie para .env.local (ignorado pelo git) e preencha.
# Sem VITE_HA_URL os cards dos ar-condicionados mostram "–" (sem dados).

# Home Assistant (opcional)
VITE_HA_URL=http://192.168.0.10:8123
VITE_HA_TOKEN=cole-aqui-um-long-lived-access-token

# Valores de exemplo nos cards dos ar-condicionados, para desenvolver sem Home Assistant.
# VITE_CLIMATE_MOCK=1
